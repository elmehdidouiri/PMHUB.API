{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"
  },
  "JwtSettings": {
    "Secret": "YOUR_32_CHAR_SECRET_KEY_HERE",
    "ExpirationMinutes": 30,
    "RefreshTokenExpirationHours": 24,
    "Issuer": "PMHubAPI",
    "Audience": "PMHubUsers"
  },
  "AppSettings": {
    "BaseUrl": "https://localhost:7081"
  },
  "FileStorage": {
    "BasePath": "wwwroot/uploads",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [ ".pdf", ".xlsx", ".docx", ".pptx" ]
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_EMAIL_HERE",
    "Password": "YOUR_APP_PASSWORD_HERE",
    "From": "PMHub <noreply@yourdomain.com>"
  },
  "AuthSettings": {
    "RefreshTokenType": "refresh_token",
    "PasswordResetCodeExpirationMinutes": 10,
    "PasswordResetTokenExpirationMinutes": 10,
    "MaxPasswordResetAttempts": 5
  },
  "CompanyStandards": {
    "HoursPerDay": 8.31,
    "AnnualHoursTarget": 2193.0,
    "WorkingDaysPerMonth": 22,
    "FiscalYearStartMonth": 10
  },
  "HourBookingReminders": {
    "IsEnabled": true,
    "WeeklyReminderDay": "Monday",
    "WeeklyReminderTime": "09:00:00",
    "NoBookingThresholdDays": 30
  }
}
